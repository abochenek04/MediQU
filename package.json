{
  "name": "mediqu-care-navigation",
  "private": true,
  "version": "3.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve:dist": "node scripts/serve-dist.mjs",
    "typecheck": "tsc -b && tsc -p config/typescript/tsconfig.server.json",
    "test": "npm run test:i18n && npm run test:palette && npm run build && npm run test:smoke",
    "test:smoke": "node scripts/smoke-test.mjs",
    "api": "node --import tsx --env-file-if-exists=server/.env server/index.ts",
    "db:migrate": "node --import tsx --env-file-if-exists=server/.env server/cli.ts migrate",
    "db:seed": "node --import tsx --env-file-if-exists=server/.env server/cli.ts seed",
    "admin:grant": "node --import tsx --env-file-if-exists=server/.env server/cli.ts admin",
    "jobs": "node --import tsx --env-file-if-exists=server/.env server/cli.ts jobs",
    "db:backup": "node --import tsx --env-file-if-exists=server/.env server/cli.ts backup",
    "test:backend": "node --import tsx --test tests/backend.test.ts",
    "test:browser": "playwright test",
    "build:staging": "node scripts/build-release.mjs staging",
    "build:production": "node scripts/build-release.mjs production",
    "test:i18n": "node scripts/i18n-audit.mjs",
    "test:palette": "node scripts/palette-audit.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.6",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
