APP_ENV=staging
APP_ORIGIN=https://staging.example.com
DATABASE_PATH=/var/data/mediq.sqlite
PORT=3001
HOST=0.0.0.0
AUTH_SECRET=replace-with-a-unique-random-staging-secret
MAIL_MODE=resend
RESEND_API_KEY=replace-in-host-secret-manager
MAIL_FROM=MediQU Staging <accounts@staging.example.com>
SERVE_STATIC=true
TRUST_PROXY=true
RUN_JOBS=true
