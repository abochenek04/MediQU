APP_ENV=production
APP_ORIGIN=https://care.example.com
DATABASE_PATH=/var/data/mediq.sqlite
PORT=3001
HOST=0.0.0.0
AUTH_SECRET=replace-with-a-different-random-production-secret
MAIL_MODE=resend
RESEND_API_KEY=replace-with-production-key-in-host-secret-manager
MAIL_FROM=MediQU <accounts@care.example.com>
SERVE_STATIC=true
TRUST_PROXY=true
RUN_JOBS=true
