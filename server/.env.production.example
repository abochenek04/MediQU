APP_ENV=production
APP_ORIGIN=https://care.example.com
DATABASE_PATH=/var/data/mediq.sqlite
PORT=3001
HOST=0.0.0.0
AUTH_SECRET=replace-with-a-different-random-production-secret
MAIL_MODE=resend
# Shared caps per 24-hour / 30-day window, including failed send attempts.
# Set either to 0 to pause outgoing email. Caps also pause new verification/recovery.
MAIL_DAILY_LIMIT=100
MAIL_MONTHLY_LIMIT=1000
RESEND_API_KEY=replace-with-production-key-in-host-secret-manager
MAIL_FROM=MediQU <accounts@care.example.com>
SERVE_STATIC=true
TRUST_PROXY=true
RUN_JOBS=true
